<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JkcnslLoginWindow"
        xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" x:Class="JkcnslLoginWindow.MainWindow"
        mc:Ignorable="d"
        Height="600" Title="JkcnslLoginWindow" Width="800" Closing="Window_Closing" Loaded="Window_Loaded">
    <Grid>
        <Wpf:WebView2 Margin="10,39,10,39" Name="webView2" />
        <TextBox Height="24" Margin="10,10,85,0" Name="textBox_uri" TextWrapping="NoWrap" VerticalAlignment="Top" VerticalContentAlignment="Center" />
        <Button Content="移動" Height="24" HorizontalAlignment="Right" Margin="0,10,10,0" VerticalAlignment="Top" Width="70" Click="Button_navigate_Click" />
        <Label Content="UserAgent:" Height="34" HorizontalAlignment="Left" Margin="10,0,0,5" ToolTip="変更後「移動」でブラウザに反映されます" VerticalAlignment="Bottom" VerticalContentAlignment="Center" Width="80" />
        <TextBox Height="24" Margin="95,0,260,10" Name="textBox_userAgent" TextWrapping="NoWrap" ToolTip="変更後「移動」でブラウザに反映されます" VerticalAlignment="Bottom" VerticalContentAlignment="Center" />
        <Button Content="Cookieをコピー" Height="24" HorizontalAlignment="Right" Margin="0,0,135,10" ToolTip="保存対象のCookie(jkcnslのnicovideo_cookie設定)をクリップボードにコピーします&#xa;(セッション情報を含むので慎重に扱ってください)" VerticalAlignment="Bottom" Width="120" Click="Button_copy_Click" />
        <Button Content="jkcnslに保存" Height="24" HorizontalAlignment="Right" Margin="0,0,10,10" Name="button_save" ToolTip="現在のUserAgentとCookieをjkcnslの設定に保存します" VerticalAlignment="Bottom" Width="120" Click="button_save_Click" />
    </Grid>
</Window>
